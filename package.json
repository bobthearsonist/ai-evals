{
  "name": "@bobthearsonist/ai-evals",
  "version": "0.1.1",
  "description": "Local skill evaluations over ACP with deterministic checks",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.94.0",
    "@agentclientprotocol/sdk": "2.0.1",
    "@anthropic-ai/claude-agent-sdk": "0.3.303",
    "@cucumber/cucumber-expressions": "20.1.0",
    "@cucumber/gherkin": "42.0.1",
    "@cucumber/messages": "34.2.1",
    "ajv": "8.20.0"
  },
  "bin": {
    "ai-evals": "./local/cli.mjs",
    "ai-evals-all": "./local/run-all.mjs"
  },
  "exports": {
